{
  "name": "dota-tuner-libc-avx",
  "description": "Defaults that were measured only in the demo scene or on a test program, checked in the replay: the thread placement (ThreadTuner 'big', N-039) against none, and glibc kept off its AVX routines (GLIBC_TUNABLES, N-047) against glibc choosing them. 150 s each.",
  "note": "Screen coordinates are the Realme GT's (2400x1080, landscape, picture fitted). The replay file must exist in Dota's replays/ folder.",
  "repeat": 2,
  "order": "abba",
  "noise_pct": 10,
  "requires_charging": true,
  "min_battery": 40,
  "session_env": [
    "FEX_PROFILESTATS=1"
  ],
  "launch_options": {
    "570": "-condebug +fps_max 120 +playdemo replays/9020144444.dem"
  },
  "variants": [
    {
      "name": "default",
      "note": "tuner big, glibc without AVX"
    },
    {
      "name": "tuner-off",
      "files": {
        "tuner.txt": "off\n"
      }
    },
    {
      "name": "libc-avx",
      "session_env": [
        "GLIBC_TUNABLES="
      ],
      "note": "an empty value: glibc picks its AVX2 routines again"
    }
  ],
  "run": [
    {
      "do": "stop_session",
      "settle": 8
    },
    {
      "do": "apply_variant"
    },
    {
      "do": "remove_file",
      "path": "steamlib/steamapps/common/dota 2 beta/game/dota/console.log"
    },
    {
      "do": "start_session",
      "game": "steam"
    },
    {
      "do": "wait",
      "until": {
        "state": "Running",
        "game": "steam"
      },
      "timeout": 120,
      "interval": 5
    },
    {
      "do": "wait",
      "until": {
        "process": "steamwebhelper"
      },
      "timeout": 300,
      "interval": 10,
      "note": "Steam's web UI is up (the main window's X title is empty on the phone)"
    },
    {
      "do": "sleep",
      "seconds": 40,
      "note": "Steam finishes logging in"
    },
    {
      "do": "steam_url",
      "url": "steam://rungameid/570"
    },
    {
      "do": "wait",
      "until": {
        "process": "^dota$"
      },
      "timeout": 180,
      "interval": 10
    },
    {
      "do": "wait",
      "until": {
        "guest_grep": {
          "file": "steamlib/steamapps/common/dota 2 beta/game/dota/console.log",
          "pattern": "LoadingDisplay changed from LOADING to NONE"
        }
      },
      "timeout": 400,
      "interval": 5,
      "note": "the replay has loaded"
    },
    {
      "do": "sleep",
      "seconds": 15
    },
    {
      "do": "drag_handle",
      "row_y": 239,
      "x_range": [
        2085,
        2300
      ],
      "to_x": 2262,
      "accept_min_x": 2230,
      "source": "mouse",
      "retries": 3,
      "settle": 8,
      "expect": {
        "process": "^dota$"
      },
      "note": "seek to the same late moment of the match"
    },
    {
      "do": "sleep",
      "seconds": 22
    },
    {
      "do": "screenshot",
      "save": "start"
    },
    {
      "do": "measure_fps",
      "seconds": 150,
      "label": "replay"
    },
    {
      "do": "kill_process",
      "match": "linuxsteamrt64/dota2"
    }
  ],
  "teardown": [
    {
      "do": "kill_process",
      "match": "linuxsteamrt64/dota2"
    }
  ]
}
